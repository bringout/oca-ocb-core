# model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__onboarding_ping
#, []
msgid "Onboarding ping"
msgstr "Uvodni ping"

# model: code:addons/mail_bot/models/mail_bot.py
#, []
msgid ""
"Sorry I'm sleepy. Or not! Maybe I'm just trying to hide my unawareness of "
"human language...%(new_line)sI can show you features if you write: "
"%(command_start)sstart the tour%(command_end)s."
msgstr ""
"Žao mi je, pospan sam. Ili ne! Možda samo pokušavam da sakrijem svoje "
"nepoznavanje ljudskog jezika...%(new_line)sMogu vam pokazati mogućnosti ako "
"napišete: %(command_start)sstart the tour%(command_end)s."

# model: code:addons/mail_bot/models/mail_bot.py
#, []
msgid ""
"Sorry, I am not listening. To get someone's attention, %(bold_start)sping "
"him%(bold_end)s. Write %(command_start)s@OdooBot%(command_end)s and select "
"me."
msgstr ""
"Izvinite, ne slušam. Da privučete nečiju pažnju, %(bold_start)spingujte "
"ga%(bold_end)s. Napišite %(command_start)s@OdooBot%(command_end)s i "
"odaberite mene."

# model: code:addons/mail_bot/models/mail_bot.py
#, []
msgid "Thanks"
msgstr "Hvala"

# model: code:addons/mail_bot/models/mail_bot.py
#, []
msgid "Thanks for your feedback. Goodbye!"
msgstr "Hvala na povratnoj informaciji. Doviđenja!"

# model: code:addons/mail_bot/models/mail_bot.py
#, []
msgid "That's not nice! I'm a bot but I have feelings... 💔"
msgstr ""
"Izvinjavam se spavajući sam. Ili nisam! Možda samo pokušavam da sakrim svoje"
" nepoznavanje ljudskog jezika...<br/>Mogu vam pokazati funkcije ako napišete"

# model: code:addons/mail_bot/models/mail_bot.py
#, []
msgid ""
"That’s the end of this overview. You can %(bold_start)sclose this "
"conversation%(bold_end)s or type %(command_start)sstart the "
"tour%(command_end)s to see it again. Enjoy exploring Odoo!"
msgstr ""
"To je kraj ovog pregleda. Možete %(bold_start)szatvoriti ovaj "
"razgovor%(bold_end)s ili ukucati %(command_start)sstart the "
"tour%(command_end)s da ga ponovo vidite. Uživajte u istraživanju Odoo-a!"

# model: code:addons/mail_bot/models/mail_bot.py
#, []
msgid "This is a temporary canned response to see how canned responses work."
msgstr ""
"Ovo je privremeni pripremljeni odgovor da vidite kako pripremljeni odgovori "
"funkcionišu."

# model: code:addons/mail_bot/models/mail_bot.py
#, []
msgid ""
"To %(bold_start)ssend an attachment%(bold_end)s, click on the "
"%(paperclip_icon)s icon and select a file."
msgstr ""
"Da %(bold_start)spošaljete prilog%(bold_end)s, kliknite na ikonu "
"%(paperclip_icon)s i odaberite datoteku."

# model: code:addons/mail_bot/models/mail_bot.py
#, []
msgid "To start, try to send me an emoji :)"
msgstr "Za početak, pokušajte mi poslati emotikon :)"

# model: code:addons/mail_bot/models/res_users.py
#, []
msgid "Try to send me an emoji"
msgstr "Pokušajte da mi pošaljete emoji"

# model: code:addons/mail_bot/models/mail_bot.py
#, []
msgid ""
"Unfortunately, I'm just a bot 😞 I don't understand! If you need help "
"discovering our product, please check %(document_link_start)sour "
"documentation%(document_link_end)s or %(slides_link_start)sour "
"videos%(slides_link_end)s."
msgstr ""
"Nažalost, ja sam samo bot 😞 Ne razumijem! Ako vam je potrebna pomoć u "
"otkrivanju našeg proizvoda, pogledajte %(document_link_start)snašu "
"dokumentaciju%(document_link_end)s ili %(slides_link_start)snaše video "
"zapise%(slides_link_end)s."

# model: model:ir.model,name:mail_bot.model_res_users
#, []
msgid "User"
msgstr "Vaša registracija za ${object.event_id.name}"

# model: code:addons/mail_bot/models/mail_bot.py
#, []
msgid ""
"Wonderful! 😇%(new_line)sTry typing %(command_start)s::%(command_end)s to use"
" canned responses. I've created a temporary one for you."
msgstr ""
"Odlično! 😇%(new_line)sPokušajte ukucati %(command_start)s::%(command_end)s "
"za korištenje pripremljenih odgovora. Kreirao sam jedan privremeni za vas."

# model: code:addons/mail_bot/models/mail_bot.py
#, []
msgid ""
"Wow you are a natural!%(new_line)sPing someone with @username to grab their "
"attention. %(bold_start)sTry to ping me using%(bold_end)s "
"%(command_start)s@OdooBot%(command_end)s in a sentence."
msgstr ""
"Vau, prirodni ste talenat!%(new_line)sPingujte nekoga sa @korisničkoime da "
"privučete pažnju. %(bold_start)sPokušajte da me pingujete "
"koristeći%(bold_end)s %(command_start)s@OdooBot%(command_end)s u rečenici."

# model: code:addons/mail_bot/models/mail_bot.py
#, []
msgid ""
"Yep, I am here! 🎉 %(new_line)sNow, try %(bold_start)ssending an "
"attachment%(bold_end)s, like a picture of your cute dog..."
msgstr ""
"Da, tu sam! 🎉 %(new_line)sSada pokušajte %(bold_start)sda pošaljete "
"prilog%(bold_end)s, na primjer sliku vašeg slatkog psa..."

# model: code:addons/mail_bot/models/mail_bot.py
#, []
msgid "fuck"
msgstr "Jeee, push obaveštenja su omogućena!"

# model: code:addons/mail_bot/models/mail_bot.py
#, []
msgid "help"
msgstr "pomoć"

# model: code:addons/mail_bot/models/mail_bot.py
#, []
msgid "i love you"
msgstr ""
"Da, ovde sam! 🎉 <br/>Završili ste turu, možete <b>zatvoriti ovaj chat "
"prozor</b>. Uživajte u otkrivanju Odoo-a."

# model: code:addons/mail_bot/models/mail_bot.py
#, []
msgid "love"
msgstr "Da, OdooBot je na mestu!"

# model: code:addons/mail_bot/models/mail_bot.py
#, []
msgid "start the tour"
msgstr "počni turu"
