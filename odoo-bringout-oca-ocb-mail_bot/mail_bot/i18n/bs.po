# model: code:addons/mail_bot/models/mail_bot.py
#, []
msgid ""
"Aaaaaw that's really cute but, you know, bots don't work that way. You're "
"too human for me! Let's keep it professional ❤️"
msgstr ""
"Aaaaw to je stvarno slatko, ali znaš, botovi ne rade tako. Previše si "
"ljudski za mene! Ostanimo profesionalni ❤️"

# model:
# model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__disabled
#, []
msgid "Disabled"
msgstr "Onemogućen"

# model: model:ir.model,name:mail_bot.model_discuss_channel
#, []
msgid "Discussion Channel"
msgstr "Kanal rasprave"

# model:
# model:ir.model.fields,field_description:mail_bot.field_discuss_channel__display_name
#, []
msgid "Display Name"
msgstr "Naziv za prikaz"

# model: code:addons/mail_bot/models/mail_bot.py
#, []
msgid ""
"Great! You can customize %(bold_start)scanned responses%(bold_end)s in the "
"Discuss app."
msgstr ""
"Odlično! Možete prilagoditi %(bold_start)spripremljene odgovore%(bold_end)s "
"u aplikaciji Discuss."

# model: code:addons/mail_bot/models/mail_bot.py
#, []
msgid ""
"Great! 👍%(new_line)sTo access special commands, %(bold_start)sstart your "
"sentence with%(bold_end)s %(command_start)s/%(command_end)s. Try getting "
"help."
msgstr ""
"Odlično! 👍%(new_line)sZa pristup posebnim komandama, %(bold_start)sotpočnite"
" svoju rečenicu sa%(bold_end)s %(command_start)s/%(command_end)s. Pokušajte "
"dobiti pomoć."

# model: code:addons/mail_bot/models/res_users.py
#, []
msgid "Hello,"
msgstr "Pozdrav,"

# model: code:addons/mail_bot/models/mail_bot.py
#, []
msgid "Hmmm..."
msgstr ""
"Odlično! 👍<br/>Sada, pokušajte da <b>pošaljete prilog</b>, kao što je slika "
"vašeg slatkog psa..."

# model: code:addons/mail_bot/models/mail_bot.py
#, []
msgid "I'm afraid I don't understand. Sorry!"
msgstr ""
"Zdravo,<br/>Odoo chat pomaže zaposlenima da sarađuju efikasno. Ja sam ovde "
"da vam pomognem da otkrijete njegove funkcije.<br/><b>Pokušajte da mi "
"pošaljete emoji :)</b>"

# model: code:addons/mail_bot/models/mail_bot.py
#, []
msgid ""
"I'm not smart enough to answer your question.%(new_line)sTo follow my guide,"
" ask: %(command_start)sstart the tour%(command_end)s."
msgstr ""
"Nisam dovoljno pametan da odgovorim na vaše pitanje.%(new_line)sDa biste "
"pratili moj vodič, upišite: %(command_start)sstart the tour%(command_end)s."

# model:
# model:ir.model.fields,field_description:mail_bot.field_discuss_channel__id
#, []
msgid "ID"
msgstr "ID"

# model:
# model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__idle
#, []
msgid "Idle"
msgstr "Na čekanju"

# model: model:ir.model,name:mail_bot.model_mail_bot
#, []
msgid "Mail Bot"
msgstr "Mali robotić"

# model: code:addons/mail_bot/models/mail_bot.py
#, []
msgid ""
"Not exactly. To continue the tour, send an emoji: "
"%(bold_start)stype%(bold_end)s%(command_start)s :)%(command_end)s and press "
"enter."
msgstr ""
"Ne baš. Za nastavak obilaska pošaljite emoji: "
"%(bold_start)sukucajte%(bold_end)s%(command_start)s :)%(command_end)s i "
"pritisnite enter."

# model:
# model:ir.model.fields.selection,name:mail_bot.selection__res_users__odoobot_state__not_initialized
#, []
msgid "Not initialized"
msgstr "Nije inicijaliziran"

# model: code:addons/mail_bot/models/mail_bot.py
#, []
msgid ""
"Not sure what you are doing. Please, type %(command_start)s/%(command_end)s "
"and wait for the propositions. Select %(command_start)shelp%(command_end)s "
"and press enter."
msgstr ""
"Nisam siguran šta radite. Molimo, ukucajte %(command_start)s/%(command_end)s"
" i sačekajte prijedloge. Odaberite %(command_start)shelp%(command_end)s i "
"pritisnite enter."

# model: code:addons/mail_bot/models/mail_bot.py
#, []
msgid ""
"Not sure what you are doing. Please, type %(command_start)s:%(command_end)s "
"and wait for the propositions. Select one of them and press enter."
msgstr ""
"Nisam siguran šta radite. Molimo, ukucajte %(command_start)s:%(command_end)s"
" i sačekajte prijedloge. Odaberite jedan od njih i pritisnite enter."

# model: code:addons/mail_bot/models/res_users.py
#, []
msgid ""
"Odoo's chat helps employees collaborate efficiently. I'm here to help you "
"discover its features."
msgstr ""
"Odoo chat pomaže zaposlenima da efikasno sarađuju. Ovdje sam da vam pomognem"
" da otkrijete njegove mogućnosti."

# model:
# model:ir.model.fields,field_description:mail_bot.field_res_users__odoobot_state
#, []
msgid "OdooBot Status"
msgstr "Status OdooBot-a"

# model:
# model:ir.model.fields,field_description:mail_bot.field_res_users__odoobot_failed
#, []
msgid "Odoobot Failed"
msgstr "Odoobot neuspješan"

