"                            <a t-att-href=\"event_website_url\" t-attf-style=\"font-weight:bold;color: {{object.event_id.company_id.email_secondary_color or '#875A7B'}}; text-decoration:none;\" t-out=\"object.event_id.name or ''\">OpenWood Collection Online Reveal</a>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <strong t-out=\"object.event_id.name or ''\">OpenWood Collection Online Reveal</strong>\n"
